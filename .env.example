# Clipfern — environment variables (all optional; the Settings page is the primary way to enter keys).
# Values here are used as DEFAULTS in development and shown as "from .env" in Settings.
# NEVER commit a real .env. Secrets are handled only in the Electron main process.

# --- LLM (the only paid service; target <= $30/month, hard cap $70) ---
ANTHROPIC_API_KEY=            # https://console.anthropic.com/settings/keys
CLIPFERN_MODEL_SMART=claude-sonnet-5-5   # moment finding, hooks, virality scoring
CLIPFERN_MODEL_FAST=claude-haiku-5-5     # titles, descriptions, hashtags, chat retrieval
CLIPFERN_BUDGET_TARGET_USD=30
CLIPFERN_BUDGET_HARD_CAP_USD=70

# --- Object storage: Cloudflare R2 (free tier 10 GB) ---
R2_ACCOUNT_ID=                # Cloudflare dashboard -> R2 -> account id
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_DOMAIN=             # optional custom/public domain for the bucket

# --- Object storage alternative: Backblaze B2 (free tier 10 GB, S3-compatible) ---
B2_ENDPOINT=                  # e.g. https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=

# --- Stock media (free keys) ---
PEXELS_API_KEY=               # https://www.pexels.com/api/
PIXABAY_API_KEY=              # https://pixabay.com/api/docs/

# --- Whop (CP6) ---
WHOP_API_KEY=                 # https://whop.com/dashboard/developer

# --- Social platforms (OAuth clients, wired in CP5) ---
GOOGLE_OAUTH_CLIENT_ID=       # YouTube Data API v3
GOOGLE_OAUTH_CLIENT_SECRET=
META_APP_ID=                  # Instagram app ID ("Instagram API with Instagram login")
META_APP_SECRET=
TIKTOK_CLIENT_KEY=            # TikTok Content Posting API
TIKTOK_CLIENT_SECRET=

# --- Runtime / dev ---
CLIPFERN_DEV_PORT=3210        # Next dev server port used by `pnpm dev`
CLIPFERN_USER_DATA=           # override userData dir (used by e2e tests)
CLIPFERN_WHISPER_MODEL=large-v3-turbo   # `tiny` is used for smoke tests
CLIPFERN_CACHE_CAP_GB=20

# --- Dev/test only: point object storage at an S3-compatible emulator (e.g. s3rver) ---
CLIPFERN_S3_ENDPOINT_OVERRIDE=
CLIPFERN_ALLOW_ANY_URL=      # dev/test only: 1 = accept direct media URLs (yt-dlp generic extractor) instead of YouTube links only
CLIPFERN_ANTHROPIC_BASE_URL=  # dev/test only: point the Claude client at a stub server

# CP4 (dev/test only): point stock B-roll at a fake Pexels / Pixabay (never needed in production)
# CLIPFERN_PEXELS_BASE_URL=http://127.0.0.1:4590
# CLIPFERN_PIXABAY_BASE_URL=http://127.0.0.1:4591

# CP5 (posting): dev/test only. Point each platform client at a local fake server (test/support/fake-*.ts).
# CLIPFERN_GOOGLE_OAUTH_BASE=http://127.0.0.1:4601
# CLIPFERN_YOUTUBE_API_BASE=http://127.0.0.1:4601
# CLIPFERN_YOUTUBE_UPLOAD_BASE=http://127.0.0.1:4601
# CLIPFERN_META_OAUTH_BASE=http://127.0.0.1:4602
# CLIPFERN_GRAPH_BASE=http://127.0.0.1:4602
# CLIPFERN_TIKTOK_AUTH_BASE=http://127.0.0.1:4603
# CLIPFERN_TIKTOK_API_BASE=http://127.0.0.1:4603
# CLIPFERN_SCHEDULER_TICK_MS=1000     # scheduler tick (default 10000)
# CLIPFERN_SKIP_QUIT_CONFIRM=1        # no "posts are scheduled" prompt on quit (automated tests)
# CLIPFERN_FORCE_TRAY=1               # Linux: create the tray icon even without XDG_CURRENT_DESKTOP
# Developer-app credentials (GOOGLE_*, META_*, TIKTOK_* above) are entered in Settings → Integrations and stored encrypted.
