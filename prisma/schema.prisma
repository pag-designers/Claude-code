// Clipfern schema v1 (metadata only — videos never live on local disk, see BRIEF §3).
// ownerId is a multi-user hook: always "local" for now (ADR-011).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  engineType      = "client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Setting {
  key       String   @id
  value     String // JSON
  updatedAt DateTime @updatedAt
}

model Job {
  id          String    @id @default(cuid())
  ownerId     String    @default("local")
  kind        String
  status      String    @default("queued") // queued | running | succeeded | failed | canceled
  priority    Int       @default(0)
  payload     String    @default("{}") // JSON
  result      String? // JSON
  progress    Float     @default(0)
  stage       String?
  error       String?
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  runAfter    DateTime  @default(now()) // backoff / scheduling
  heartbeatAt DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?
  groupKey    String? // e.g. projectId — lets stages of one pipeline be listed together
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAfter, priority])
  @@index([groupKey])
}

model Notification {
  id        String    @id @default(cuid())
  ownerId   String    @default("local")
  kind      String
  level     String    @default("info")
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([readAt, createdAt])
}

model CostEvent {
  id           String   @id @default(cuid())
  ownerId      String   @default("local")
  provider     String   @default("anthropic")
  model        String
  purpose      String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  cachedTokens Int      @default(0) // cache reads
  cacheWrites  Int      @default(0)
  costUsd      Float    @default(0)
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

model StorageSnapshot {
  id          String   @id @default(cuid())
  ownerId     String   @default("local")
  provider    String
  usedBytes   BigInt   @default(0)
  objectCount Int      @default(0)
  breakdown   String   @default("{}") // JSON {category: bytes}
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// ---- Domain tables used from CP1 onward (created now so schema v1 is stable) ----

model Video {
  id          String   @id @default(cuid())
  ownerId     String   @default("local")
  sourceUrl   String
  sourceId    String? // e.g. YouTube video id
  title       String
  channel     String?
  durationSec Float?
  thumbnail   String?
  status      String   @default("new") // new | ingesting | processing | ready | failed
  contentHash String?
  storageKeys String   @default("{}") // JSON {source, proxy, audio, transcript, ...} -> object keys
  metadata    String   @default("{}") // JSON (yt-dlp info, chapters...)
  favorite    Boolean  @default(false)
  stage       String? // current pipeline stage
  progress    Float? // 0..1 within the stage
  error       String?
  options     String   @default("{}") // JSON PipelineOptions
  stages      String   @default("[]") // JSON StageState[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  clips       Clip[]

  @@index([sourceId])
  @@index([createdAt])
}

model Clip {
  id             String   @id @default(cuid())
  ownerId        String   @default("local")
  videoId        String
  video          Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  title          String
  hook           String?
  startSec       Float
  endSec         Float
  score          Int? // virality 0-100
  scoreDetail    String? // JSON breakdown
  status         String   @default("candidate") // candidate | queued | rendering | rendered | failed
  rank           Int?
  error          String?
  renderProgress Float?
  aspect         String   @default("9:16")
  favorite       Boolean  @default(false)
  tags           String   @default("[]") // JSON string[]
  storageKeys    String   @default("{}") // JSON
  metadata       String   @default("{}") // JSON
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([videoId])
  @@index([score])
}
