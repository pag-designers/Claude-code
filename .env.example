# Copy this file to .env and fill in your values. .env is git-ignored — never commit it.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional settings (defaults shown)
# CLIPPER_MODEL=claude-opus-5-5        # claude-sonnet-5-5 is about half the price
# CLIPPER_EFFORT=medium                # low | medium | high (how hard Claude thinks)
# CLIPPER_WHISPER_MODEL=small          # tiny | base | small | medium | large-v3 (bigger = slower, more accurate)
# CLIPPER_WHISPER_THREADS=4
