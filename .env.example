# Copy this file to .env and fill in your values (or use the app's ⚙ Settings panel, which writes .env for you).
# .env is git-ignored — never commit it.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional settings (defaults shown)
# CLIPPER_MODEL=claude-haiku-5-5       # claude-haiku-5-5 (cheapest) | claude-sonnet-5-5 | claude-opus-5-5 (best)
# CLIPPER_EFFORT=medium                # low | medium | high (how hard Claude thinks)
# CLIPPER_WHISPER_MODEL=small          # tiny | base | small | medium | large-v3 (bigger = slower, more accurate)
# CLIPPER_WHISPER_THREADS=4
